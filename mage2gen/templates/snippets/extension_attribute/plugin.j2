     * @return SearchResultsInterface
     */
    public function afterGetList(
        {{ repository|split('\\')|last }} $subject,
        SearchResultsInterface $searchResult
    ) {
        foreach ($searchResult->getItems() as $entity) {
            $this->loadExtensionAttribute($entity);
        }
        return $searchResult;
    }

    /**
     * @param {{ repository|split('\\')|last }} $subject
     * @param {{ entity_interface }} $entity
     * @return array
     */
    public function beforeSave(
        {{ repository|split('\\')|last }} $subject,
        {{ entity_interface }} $entity
    ) {
        $extensionAttributes = $entity->getExtensionAttributes();
        if ($extensionAttributes && $extensionAttributes->get{{ code_camel }}() !== null) {
            $entity->setData('{{ code }}', $extensionAttributes->get{{ code_camel }}());
        }
        return [$entity];
    }

    /**
     * Load Extension Attribute from Data Model
     *
     * @param {{ entity_interface }} $entity
     */
    private function loadExtensionAttribute({{ entity_interface }} $entity)
    {
        $extensionAttributes = $entity->getExtensionAttributes();
        if ($extensionAttributes === null) {
            $extensionAttributes = $this->extensionFactory->create();
        }

        // Hydrate extension attribute from model data (database column)
        $value = $entity->getData('{{ code }}');
        
        {% if type == 'int' or type == 'integer' %}
        $value = (int) $value;
        {% elif type == 'float' %}
        $value = (float) $value;
        {% elif type == 'bool' or type == 'boolean' %}
        $value = (bool) $value;
        {% endif %}

        $extensionAttributes->set{{ code_camel }}($value);
        $entity->setExtensionAttributes($extensionAttributes);
    }
}