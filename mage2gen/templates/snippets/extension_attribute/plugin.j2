     */
    public function __construct(
        {{ interface|split('\\')|last }}Factory $extensionFactory
    ) {
        $this->extensionFactory = $extensionFactory;
    }

    /**
     * @param {{ repository|split('\\')|last }} $subject
     * @param {{ entity_interface }} $entity
     * @return {{ entity_interface }}
     */
    public function afterGet(
        {{ repository|split('\\')|last }} $subject,
        {{ entity_interface }} $entity
    ) {
        $this->loadExtensionAttribute($entity);
        return $entity;
    }

    /**
     * @param {{ repository|split('\\')|last }} $subject
