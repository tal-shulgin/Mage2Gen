<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:DataObject/etc/fieldset.xsd">
    <scope id="global">
        {% if checkout_billing %}
        <fieldset id="extra_checkout_billing_address_fields">
            <field name="{{ code }}">
                <aspect name="to_order_address" />
                <aspect name="to_customer_address" />
            </field>
        </fieldset>
        {% endif %}
        {% if checkout_shipping %}
        <fieldset id="extra_checkout_shipping_address_fields">
            <field name="{{ code }}">
                <aspect name="to_order_address" />
                <aspect name="to_customer_address" />
            </field>
        </fieldset>
        {% endif %}
    </scope>
</config>