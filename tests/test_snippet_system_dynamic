import unittest
from mage2gen import Module
from mage2gen.snippets.system_dynamic import SystemDynamicRowSnippet
from tests import utils

class TestSnippetSystemDynamic(unittest.TestCase):

    def test_dynamic_row(self):
        module = Module(package='Test', name='Dyn', description='Desc')
        snippet = SystemDynamicRowSnippet(module)
        
        snippet.add('general', 'ui', 'map', 'locations', 'lat:Latitude,lon:Longitude')

        result = utils.CodeSniffer.generate_and_test(module)
        self.assertTrue(result)
        
        files = list(module._static_files.keys())
        self.assertTrue(any('LocationsRow.php' in f for f in files))

    def tearDown(self):
        utils.CodeSniffer.cleanup()