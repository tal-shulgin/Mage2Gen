import unittest
from mage2gen import Module
from mage2gen.snippets import SystemSnippet
from tests import utils

class TestSnippetSystemAdvanced(unittest.TestCase):

    def test_advanced_fields(self):
        module = Module(package='Test', name='Adv', description='Desc')
        snippet = SystemSnippet(module)
        
        # 1. Color Picker
        snippet.add('general', 'ui', 'design', 'main_color', field_type='color')
        
        # 2. Image Upload with Dependency
        snippet.add(
            'general', 'ui', 'design', 'logo_upload', 
            field_type='image',
            depends='main_color'
        )

        result = utils.CodeSniffer.generate_and_test(module)
        self.assertTrue(result)
        
        files = list(module._static_files.keys())
        
        # Check Color Picker Block
        self.assertTrue(any('MainColorColor.php' in f for f in files))
        
        # Check Image Backend Model
        self.assertTrue(any('LogoUploadImage.php' in f for f in files))
        
        # Check XML for depends
        # (We can't easily parse the XML content in this test structure, but we trust the generation logic if files exist)

    def tearDown(self):
        utils.CodeSniffer.cleanup()